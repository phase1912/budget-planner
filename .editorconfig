root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python — matches ruff's formatter (backend/pyproject.toml [tool.ruff])
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

# TypeScript / React / web config
[*.{ts,tsx,js,jsx,json,css}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
