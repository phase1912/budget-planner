# Overrides for docker-compose.yml's local Postgres and MinIO. Copy to .env
# and adjust if you need non-default credentials or ports; the compose file
# works with none of this set.
POSTGRES_USER=budget_planner
POSTGRES_PASSWORD=budget_planner
POSTGRES_DB=budget_planner
POSTGRES_PORT=5432

MINIO_ROOT_USER=budget_planner
MINIO_ROOT_PASSWORD=budget_planner_minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
