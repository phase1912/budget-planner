# Copy to .env and fill in. Loaded by app.config.Settings (pydantic-settings);
# nothing else in the codebase should read these directly. Used when running
# the API on the host (uv run); the backend container instead gets
# DATABASE_URL and ANTHROPIC_API_KEY from docker-compose.yml's `environment:`,
# which takes precedence over this file.

# Matches docker-compose.yml's postgres service and its default credentials —
# only the host differs (localhost, since this file is for running the API
# on the host). Adjust if you overrode POSTGRES_* in the repo-root .env.
DATABASE_URL=postgresql+asyncpg://budget_planner:budget_planner@localhost:5432/budget_planner

ANTHROPIC_API_KEY=sk-ant-replace-me
