# Copy to .env and fill in. Loaded by app.config.Settings (pydantic-settings);
# nothing else in the codebase should read these directly. Used when running
# the API on the host (uv run); the backend container instead gets
# DATABASE_URL and ANTHROPIC_API_KEY from docker-compose.yml's `environment:`,
# which takes precedence over this file.

# Matches docker-compose.yml's postgres service and its default credentials —
# only the host differs (localhost, since this file is for running the API
# on the host). Adjust if you overrode POSTGRES_* in the repo-root .env.
DATABASE_URL=postgresql+asyncpg://budget_planner:budget_planner@localhost:5432/budget_planner

ANTHROPIC_API_KEY=sk-ant-replace-me

# Provider-agnostic LLM settings (ADR-0006)
# Default is Google Gemini (gemini/gemini-3.6-flash).
# To use a custom provider (like Z-AI), uncomment and set these:
# LLM_MODEL=openai/your-model-name
# LLM_API_KEY=sk-your-api-key
# LLM_API_BASE=https://api.z-ai.com/v1

# Everything below is optional — commented out, so Settings' defaults apply.
# Full reference: ../docs/architecture/configuration.md

# Deployment tier: local / staging / production (app.config.Environment).
# Leave unset locally; staging/production set this at deploy time (F0.7.3).
# ENVIRONMENT=local

# Claude model id. Defaults to the local/staging tier (claude-haiku-4-5-20251001);
# production sets claude-sonnet-5 explicitly. See ADR-0005.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Manual-review triggers (BRD A10, C3). Defaults per ADR-0005; must be within [0.0, 1.0].
# OCR_CONFIDENCE_THRESHOLD=0.80
# CATEGORIZATION_CONFIDENCE_THRESHOLD=0.70

# Authentication Settings
# JWT_SECRET_KEY=change_me_in_production
# ACCESS_TOKEN_EXPIRE_MINUTES=240
# REFRESH_TOKEN_EXPIRE_DAYS=30

# Local hybrid-reasoning models (Qwen3 and kin, via LM Studio/Ollama) answer inside
# their reasoning channel and return empty content, which breaks extraction. Leave
# unset for hosted providers — they reject the parameter.
#LLM_DISABLE_REASONING=true

# One model instance serialises requests anyway, so parallel extraction only
# evicts its own prompt cache. Keep at 1 for a local model.
#LLM_MAX_CONCURRENCY=2

# How long one upload job may spend extracting before it is marked failed.
#UPLOAD_JOB_TIMEOUT_SECONDS=900

# LM Studio's constrained decoding corrupts key names, so every extraction comes
# back empty. Set this for a local model; leave unset for hosted providers.
#LLM_DISABLE_JSON_SCHEMA=true
