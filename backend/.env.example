# Copy to .env and fill in. Loaded by app.config.Settings (pydantic-settings);
# nothing else in the codebase should read these directly.

# Matches docker-compose.yml's postgres service and its default credentials —
# only the host differs (localhost, since the API runs on the host, not in
# the compose stack). Adjust if you overrode POSTGRES_* in the repo-root .env.
DATABASE_URL=postgresql+asyncpg://budget_planner:budget_planner@localhost:5432/budget_planner

ANTHROPIC_API_KEY=sk-ant-replace-me
