{
  "name": "budget-planner-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-prerender.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "app:prod": "VITE_API_BASE_URL=https://backend-tccwtb3i5q-uc.a.run.app npm run build && cap sync",
    "app:local": "VITE_API_BASE_URL=http://localhost:8000 npm run build && cap sync",
    "app:ios:prod": "VITE_API_BASE_URL=https://backend-tccwtb3i5q-uc.a.run.app npm run build && cap copy ios",
    "app:ios:local": "VITE_API_BASE_URL=http://localhost:8000 npm run build && cap copy ios",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:responsive": "node scripts/check-responsive.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api": "bash scripts/generate-api-types.sh",
    "lint:locales": "node scripts/check-locales.mjs",
    "lint:privacy": "node scripts/check-privacy.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "i18next": "^25.10.10",
    "lucide-react": "^1.33.0",
    "mobx": "^7.0.3",
    "mobx-react-lite": "^5.0.3",
    "openapi-fetch": "^0.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
